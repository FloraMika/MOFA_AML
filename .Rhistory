Methylation = mofa.sel@data$DNAm$AML,
Proteins = mofa.sel@data$Proteomics$AML)
colnames(data_2$DSRT) == colnames(data_2$Genes)
a <-colSums(is.na(data_2$DSRT)) != nrow(data_2$DSRT)
b <-colSums(is.na(data_2$Genes)) != nrow(data_2$Genes)
c <-colSums(is.na(data_2$Mutations)) != nrow(data_2$Mutations)
d <-colSums(is.na(data_2$Methylation)) != nrow(data_2$Methylation)
e <-colSums(is.na(data_2$Proteins)) != nrow(data_2$Proteins)
table_missing <- rbind(a, b, c, d, e)
table_missing <- 1*table_missing
rownames(table_missing) <- c("DSRT", "Genes", "Mutations", "Methylation", "Proteins")
table_missing <- data.frame(table_missing)
table_missing$percentage <- as.vector(rowSums(table_missing)/118)
percent <- c(0.9, 0.8, 0.7, 0.6, 0.5)
name <- c("90", "80", "70", "60", "50")
list_datasets <- list()
for (i in 1:5) {
per <- percent[i]
name_ana <- name[i]
print(c(name_ana, per))
