length(x)
y <- sample(colnames(table_missing)[table_missing[1,] == 0], length(colnames(table_missing)[table_missing[1,] == 0])*per)
length(y)
table_missing_2 <- table_missing[, colnames(table_missing) %in% c(x, y)]
table_missing_2$percentage <- as.vector(rowSums(table_missing_2)/ncol(table_missing_2))
print(table_missing_2$percentage)
print(table_missing$percentage)
print(dim(table_missing_2))
data_sub <- list(
DSRT = mofa.sel@data$DSRT$AML[, colnames(mofa.sel@data$DSRT$AML) %in% colnames(table_missing_2)],
Genes = mofa.sel@data$RNAseq$AML[, colnames(mofa.sel@data$RNAseq$AML) %in% colnames(table_missing_2)],
Mutations =mofa.sel@data$Mutations$AML[, colnames(mofa.sel@data$Mutations$AML) %in% colnames(table_missing_2)],
Methylation = mofa.sel@data$DNAm$AML[, colnames(mofa.sel@data$DNAm$AML) %in% colnames(table_missing_2)],
Proteins = mofa.sel@data$Proteomics$AML[, colnames(mofa.sel@data$Proteomics$AML) %in% colnames(table_missing_2)])
colnames(data_sub$DSRT) == colnames(data_sub$Genes)
saveRDS(data_sub, paste0("/home/flomik/Data/MOFA_R_Objects/Robustness/", name_ana, "_data_input_MOFA.rds"))
list_datasets[[i]] <- data_sub
}
