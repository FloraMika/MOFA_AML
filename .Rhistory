outfile <- paste0("/data/MOFA_v04_train_5_views_",i,".hdf5")
mofa.list[[i]] <- run_mofa(mofa.toTrain, outfile, use_basilisk = T)
mofa.sel <- select_model(mofa.list)
}
save(mofa.sel, file=paste0("/home/flomik/Data/MOFA_R_Objects/Robustness/", name, "_MOFA.RData"))
return(mofa.sel)
}
