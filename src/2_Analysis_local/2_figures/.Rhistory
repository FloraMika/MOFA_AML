library(tidyverse)
library(dplyr)
library(ggplot2)
library(openxlsx)
library(gtools)
library(stringr)
path <- getwd()
new_path <- gsub("MOFA_AML/.*","MOFA_AML/",path)
# =========================
# Load data
# =========================
mfactor_data <- read.xlsx(
"data/MOFA/data-drivenFeatures.xlsx",
sheet = "Blad2"
)
# =========================
# Load data
# =========================
mfactor_data <- read.xlsx(
"data/MOFA/data-drivenFeatures.xlsx", 2)
path <- getwd()
new_path <- gsub("MOFA_AML/.*","MOFA_AML/",path)
# =========================
# Load data
