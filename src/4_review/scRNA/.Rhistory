#table_correlation$Factor <- factor(table_correlation$Factor, levels = table_correlation$Factor[!duplicated(table_correlation$Factor)])
# required, otherwise you cannot use the values as fill
mydat_wide <- table_correlation %>% pivot_wider(names_from = "sign", values_from = "R")
mydat_wide <- data.frame(mydat_wide)
#mydat_wide <- mydat_wide[!is.na(mydat_wide$pos) | !is.na(mydat_wide$neg),]
# making your ordered months factor
mydat_wide$Cell_type <- droplevels(factor(mydat_wide$Cell_type))
# The actual triangle computation
newcoord_up <- make_triangles(mydat_wide$Cell_type, mydat_wide$Factor)
newcoord_down <- make_triangles(mydat_wide$Cell_type, mydat_wide$Factor, point = "down")
# just a dirty trick for renaming
newcoord_down <- newcoord_down %>% dplyr::select(xdown = x, ydown = y)
# you need to repeat each row of your previous data frame 3 times
repdata <- map_df(1:nrow(mydat_wide), function(i) mydat_wide[rep(i, 3), ])
newdata <- bind_cols(repdata, newcoord_up, newcoord_down)
colnames(newdata)[colnames(newdata) == "X1"] <- "r_ddhms_vs_cell_types"
colnames(newdata)[colnames(newdata) == "X.1"] <- "r_txn_scores_vs_cell_types"
#newdata$Factor <- factor(newdata$Factor, levels = rev(c(newdata$Factor[!duplicated(newdata$Factor)])))
ggplot(newdata) +
geom_polygon(aes(x = x, y = y, fill = r_ddhms_vs_cell_types, group = interaction(Factor, Cell_type)), color = "#555555", size = 0.1) +
scale_fill_gradient2(low = "#2166AC", mid = "#fbf6f0", high = "#B2182B", midpoint = 0, space = "Lab", na.value = "#DDDDDD", guide = "colourbar") +
ggnewscale::new_scale_fill() +
geom_polygon(aes(x = xdown, y = ydown, fill = r_txn_scores_vs_cell_types, group = interaction(Factor, Cell_type)), color = "#555555", size = 0.1) +
scale_fill_gradient2(low = "#297c23", mid = "#fbf6f0", high = "#76237c", midpoint = 0, space = "Lab", na.value = "#DDDDDD", guide = "colourbar") +
scale_x_continuous(breaks = seq_along(unique(mydat_wide$Cell_type)),
labels = unique(levels(mydat_wide$Cell_type))) +
scale_y_continuous(breaks = seq_along(unique(mydat_wide$Factor)),
labels = unique(mydat_wide$Factor))+
coord_equal()+
theme(
#legend.position = "none",
panel.background = element_blank(), # bg of the panel
panel.grid.major = element_blank(), # get rid of major grid
panel.grid.minor = element_blank(), # get rid of minor grid
axis.title=element_blank(),
panel.grid=element_blank(),
axis.ticks=element_blank(),
axis.text.x = element_text(size = 14, angle = 60, hjust=1, colour = "black"),
axis.text.y = element_text(size = 14, colour = "black"))
ggsave("results/figures/test_triangles_correlation_MOFA_2_corrected.pdf", width = 10, height = 10)
View(table_correlation)
